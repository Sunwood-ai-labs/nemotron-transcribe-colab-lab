                    {%- set ns.audios = ns.audios + 1 %}
                {%- endif %}
            {%- endfor %}
            {%- if ns.text == "<|audio|>" %}
                {%- set ns.text = "" %}
                {%- set ns.audios = ns.audios + 1 %}
            {%- endif %}
            {%- set locators = (["<|audio|>"] * ns.audios) | join(" ") %}
            {%- set content = (ns.text ~ " " ~ locators) if ns.text else locators %}
